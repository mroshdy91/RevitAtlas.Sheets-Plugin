{
  "name": "atlas-sheets",
  "version": "2.0.0-alpha.1",
  "description": "Create and edit Revit drawing views, sheets and layouts. Requires Atlas Core.",
  "mcpServers": {
    "atlas_sheets": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "${extensionPath}/scripts/atlas-mcp.ps1",
        "-Surface",
        "sheets",
        "-Interface",
        "v2-candidate"
      ]
    }
  }
}
