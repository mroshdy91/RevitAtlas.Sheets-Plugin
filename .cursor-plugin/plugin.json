{
  "name": "atlas-sheets",
  "version": "0.1.0-beta.4",
  "description": "Create and edit Revit drawing views, sheets and layouts. Requires Atlas Core.",
  "author": {
    "name": "ROSHDY"
  },
  "homepage": "https://github.com/mroshdy91/RevitAtlas.Sheets-Plugin",
  "repository": "https://github.com/mroshdy91/RevitAtlas.Sheets-Plugin",
  "license": "LicenseRef-Atlas-Free-Use",
  "keywords": [
    "revit",
    "bim",
    "sheets"
  ],
  "mcpServers": {
    "atlas_sheets": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "${CURSOR_PLUGIN_ROOT}/scripts/atlas-mcp.ps1",
        "-Surface",
        "sheets"
      ]
    }
  }
}
